---
import BaseLayout from "@components/base/BaseLayout.astro";

// Site key pubblica: viene inlineata nell'HTML a build time, non è un segreto.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const inputClass =
  "w-full rounded-md border border-border bg-bg-p px-4 py-2 dark:border-darkmode-border dark:bg-darkmode-bg-p";
const errorClass = "mt-1 text-sm text-red-600 dark:text-red-400";
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-6">
          <div class="glass rounded-lg p-8">
            <h1 class="mb-6">Contattami</h1>

            {
              !turnstileSiteKey && import.meta.env.DEV && (
                <p class="mb-6 rounded-md border border-amber-500 p-3 text-sm">
                  <strong>PUBLIC_TURNSTILE_SITE_KEY</strong> non è impostata: il widget
                  antispam non verrà mostrato e l'invio verrà rifiutato dal server.
                  Vedi <code>.env.example</code>.
                </p>
              )
            }

            <form id="contact-form" method="POST" action="/api/contact">
              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="nome">Nome</label>
                <input
                  id="nome"
                  name="nome"
                  type="text"
                  required
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                  placeholder="Il tuo nome"
                  aria-describedby="errore-nome"
                  class={inputClass}
                />
                <p id="errore-nome" class={errorClass} data-error-for="nome" hidden></p>
              </div>

              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="email">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  placeholder="la@tua.email"
                  aria-describedby="errore-email"
                  class={inputClass}
                />
                <p id="errore-email" class={errorClass} data-error-for="email" hidden></p>
              </div>

              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="messaggio">Messaggio</label>
                <textarea
                  id="messaggio"
                  name="messaggio"
                  rows="5"
                  required
                  minlength="10"
                  maxlength="5000"
                  placeholder="Scrivi il tuo messaggio..."
                  aria-describedby="errore-messaggio"
                  class={inputClass}></textarea>
                <p id="errore-messaggio" class={errorClass} data-error-for="messaggio" hidden></p>
              </div>

              <div class="mb-6">
                <label class="flex items-start gap-2 text-sm">
                  <input
                    name="consenso"
                    type="checkbox"
                    required
                    aria-describedby="errore-consenso"
                    class="mt-1 rounded border-border dark:border-darkmode-border"
                  />
                  <span>
                    Ho letto l'<a href="/terms">informativa privacy</a> e acconsento al
                    trattamento dei dati per essere ricontattato.
                  </span>
                </label>
                <p id="errore-consenso" class={errorClass} data-error-for="consenso" hidden></p>
              </div>

              {/* Honeypot: fuori dallo schermo e fuori dal flusso di tabulazione. */}
              <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
                <label for="sito">Sito web</label>
                <input id="sito" name="sito" type="text" tabindex="-1" autocomplete="off" />
              </div>

              {/* Millisecondi di compilazione, valorizzati dal client al submit. */}
              <input name="elapsed" type="hidden" value="0" />

              {
                turnstileSiteKey && (
                  <div
                    id="turnstile-widget"
                    class="mb-6"
                    data-sitekey={turnstileSiteKey}
                  />
                )
              }

              <button
                type="submit"
                class="glass-t inline-flex items-center gap-2 rounded-md px-6 py-2 font-bold disabled:cursor-not-allowed disabled:opacity-70"
              >
                <svg
                  data-spinner
                  class="hidden h-4 w-4 animate-spin"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                    opacity="0.25"></circle>
                  <path
                    d="M12 2a10 10 0 0 1 10 10"
                    stroke="currentColor"
                    stroke-width="4"
                    stroke-linecap="round"></path>
                </svg>
                <span data-label>Invia</span>
              </button>

              <p id="contact-status" class="mt-4 text-sm" role="status" aria-live="polite" hidden>
              </p>

              <noscript>
                <p class="mt-4 text-sm">
                  L'invio del modulo richiede JavaScript per la verifica antispam.
                  In alternativa scrivimi direttamente via email.
                </p>
              </noscript>
            </form>

            {/* Prende il posto del form a invio riuscito. */}
            <div id="contact-success" class="py-4 text-center" hidden>
              <div
                class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-full bg-green-600 text-white"
              >
                <svg
                  class="h-9 w-9"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m5 13 4.5 4.5L19 7"></path>
                </svg>
              </div>
              <h2 class="h4 mb-3" tabindex="-1">Messaggio inviato</h2>
              <p class="mb-6">
                Grazie per avermi scritto. Ho ricevuto il tuo messaggio e ti risponderò
                al più presto.
              </p>
              <button
                type="button"
                id="contact-reset"
                class="glass-t rounded-md px-6 py-2 font-bold"
              >
                Invia un altro messaggio
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  async
  defer
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  type Field = HTMLInputElement | HTMLTextAreaElement;

  /**
   * Testi di errore in italiano, allineati a quelli di /api/contact: l'utente
   * legge la stessa frase sia che lo blocchi il browser sia che lo blocchi il server.
   * I messaggi nativi del browser seguono la lingua della sua interfaccia, non
   * quella della pagina, quindi vanno sostituiti a mano.
   */
  const MESSAGES: Record<
    string,
    { missing: string; short?: string; type?: string }
  > = {
    nome: {
      missing: "Inserisci il tuo nome.",
      short: "Il nome deve avere almeno 2 caratteri.",
    },
    email: {
      missing: "Inserisci il tuo indirizzo email.",
      type: "Controlla l'indirizzo email.",
    },
    messaggio: {
      missing: "Scrivi un messaggio.",
      short: "Scrivi un messaggio un po' più esteso (almeno 10 caratteri).",
    },
    consenso: {
      missing: "Devi accettare l'informativa privacy per inviare il messaggio.",
    },
  };

  const messageFor = (field: Field): string | null => {
    if (field.validity.valid) return null;
    const messages = MESSAGES[field.name];
    if (!messages) return "Valore non valido.";
    if (field.validity.valueMissing) return messages.missing;
    if (field.validity.typeMismatch && messages.type) return messages.type;
    if (field.validity.tooShort && messages.short) return messages.short;
    if (field.validity.tooLong)
      return `Hai superato il limite di ${field.maxLength} caratteri.`;
    return "Valore non valido.";
  };

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    // Disattiviamo i popup nativi solo via JS: senza JS resta la validazione
    // del browser, che è meglio di nessuna validazione.
    form.noValidate = true;

    const status = form.querySelector<HTMLElement>("#contact-status");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const spinner = form.querySelector<SVGElement>("[data-spinner]");
    const submitLabel = form.querySelector<HTMLElement>("[data-label]");
    const elapsed = form.querySelector<HTMLInputElement>("input[name=elapsed]");
    const widgetHolder = form.querySelector<HTMLElement>("#turnstile-widget");
    const success = document.querySelector<HTMLElement>("#contact-success");
    const resetButton = document.querySelector<HTMLButtonElement>("#contact-reset");
    const loadedAt = Date.now();
    let widgetId: string | undefined;

    const setLoading = (loading: boolean) => {
      if (submit) submit.disabled = loading;
      spinner?.classList.toggle("hidden", !loading);
      if (submitLabel) submitLabel.textContent = loading ? "Invio in corso…" : "Invia";
      form.setAttribute("aria-busy", String(loading));
    };

    const renderWidget = () => {
      if (!widgetHolder || !window.turnstile) return;
      if (widgetHolder.dataset.rendered === "true") return;
      const sitekey = widgetHolder.dataset.sitekey;
      if (!sitekey) return;
      widgetHolder.dataset.rendered = "true";
      widgetId = window.turnstile.render(widgetHolder, { sitekey });
    };

    if (window.turnstile) {
      renderWidget();
    } else {
      // api.js è caricato in async: attendiamo che si registri senza bloccare la pagina.
      const poll = window.setInterval(() => {
        if (!window.turnstile) return;
        window.clearInterval(poll);
        renderWidget();
      }, 150);
      window.setTimeout(() => window.clearInterval(poll), 10_000);
    }

    // L'esito positivo non passa più di qui: al suo posto compare il blocco
    // di conferma, quindi questa riga serve solo agli errori.
    const showStatus = (message: string) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
      status.className = "mt-4 text-sm text-red-600 dark:text-red-400";
    };

    /** Scambia form e conferma, spostando il fuoco perché il cambio sia percepibile. */
    const showSuccess = () => {
      form.hidden = true;
      if (!success) return;
      success.hidden = false;
      success.querySelector<HTMLElement>("h2")?.focus();
    };

    const showForm = () => {
      if (success) success.hidden = true;
      form.hidden = false;
      form.reset();
      // Il widget va ripristinato dopo essere tornato visibile, altrimenti
      // il nuovo invio riuserebbe un token già consumato.
      window.turnstile?.reset(widgetId);
      form.querySelector<HTMLInputElement>("input[name=nome]")?.focus();
    };

    resetButton?.addEventListener("click", showForm);

    const errorSlot = (name: string) =>
      form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);

    const setError = (name: string, message: string) => {
      const slot = errorSlot(name);
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
      form
        .querySelector(`[name="${name}"]`)
        ?.setAttribute("aria-invalid", "true");
    };

    const clearErrors = () => {
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((slot) => {
        slot.textContent = "";
        slot.hidden = true;
      });
      form
        .querySelectorAll("[aria-invalid]")
        .forEach((field) => field.removeAttribute("aria-invalid"));
    };

    /** Ritorna true se il form è valido; altrimenti segnala i campi e mette il fuoco sul primo. */
    const validate = () => {
      const fields = Array.from(
        form.querySelectorAll<Field>("input[name], textarea[name]"),
      ).filter((field) => field.name in MESSAGES);

      let firstInvalid: Field | null = null;
      for (const field of fields) {
        const message = messageFor(field);
        if (!message) continue;
        setError(field.name, message);
        firstInvalid ??= field;
      }
      firstInvalid?.focus();
      return firstInvalid === null;
    };

    // Appena l'utente corregge un campo, l'errore relativo sparisce.
    const revalidateField = (event: Event) => {
      const target = event.target;
      if (
        !(target instanceof HTMLInputElement) &&
        !(target instanceof HTMLTextAreaElement)
      )
        return;
      if (!(target.name in MESSAGES) || !target.validity.valid) return;
      const slot = errorSlot(target.name);
      if (slot) {
        slot.textContent = "";
        slot.hidden = true;
      }
      target.removeAttribute("aria-invalid");
    };
    form.addEventListener("input", revalidateField);
    form.addEventListener("change", revalidateField);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      clearErrors();
      if (status) status.hidden = true;
      if (!validate()) {
        showStatus("Controlla i campi segnalati.");
        return;
      }

      if (elapsed) elapsed.value = String(Date.now() - loadedAt);
      setLoading(true);

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        const payload = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          fields?: Record<string, string[] | undefined>;
        };

        if (response.ok && payload.ok) {
          form.reset();
          showSuccess();
        } else {
          for (const [field, messages] of Object.entries(payload.fields ?? {})) {
            const message = messages?.[0];
            if (message) setError(field, message);
          }
          showStatus(payload.error ?? "Invio non riuscito. Riprova più tardi.");
        }
      } catch {
        showStatus("Connessione non disponibile. Riprova più tardi.");
      } finally {
        // Il token è monouso: va ripristinato sia dopo un errore sia dopo
        // un invio riuscito, in vista di un eventuale secondo messaggio.
        window.turnstile?.reset(widgetId);
        setLoading(false);
      }
    });
  }

  // ClientRouter è attivo: astro:page-load scatta sia al primo caricamento
  // sia dopo ogni navigazione client-side.
  document.addEventListener("astro:page-load", initContactForm);
</script>
