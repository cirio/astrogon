---
import BaseLayout from "@components/base/BaseLayout.astro";

// Site key pubblica: viene inlineata nell'HTML a build time, non è un segreto.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const inputClass =
  "w-full rounded-md border border-border bg-bg-p px-4 py-2 dark:border-darkmode-border dark:bg-darkmode-bg-p";
const errorClass = "mt-1 text-sm text-red-600 dark:text-red-400";
---

<BaseLayout>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-6">
          <div class="glass rounded-lg p-8">
            <h1 class="mb-6">Contattami</h1>

            {
              !turnstileSiteKey && import.meta.env.DEV && (
                <p class="mb-6 rounded-md border border-amber-500 p-3 text-sm">
                  <strong>PUBLIC_TURNSTILE_SITE_KEY</strong> non è impostata: il widget
                  antispam non verrà mostrato e l'invio verrà rifiutato dal server.
                  Vedi <code>.env.example</code>.
                </p>
              )
            }

            <form id="contact-form" method="POST" action="/api/contact">
              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="nome">Nome</label>
                <input
                  id="nome"
                  name="nome"
                  type="text"
                  required
                  minlength="2"
                  maxlength="100"
                  autocomplete="name"
                  placeholder="Il tuo nome"
                  class={inputClass}
                />
                <p class={errorClass} data-error-for="nome" hidden></p>
              </div>

              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="email">Email</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  maxlength="254"
                  autocomplete="email"
                  placeholder="la@tua.email"
                  class={inputClass}
                />
                <p class={errorClass} data-error-for="email" hidden></p>
              </div>

              <div class="mb-4">
                <label class="mb-1 block font-semibold" for="messaggio">Messaggio</label>
                <textarea
                  id="messaggio"
                  name="messaggio"
                  rows="5"
                  required
                  minlength="10"
                  maxlength="5000"
                  placeholder="Scrivi il tuo messaggio..."
                  class={inputClass}></textarea>
                <p class={errorClass} data-error-for="messaggio" hidden></p>
              </div>

              <div class="mb-6">
                <label class="flex items-start gap-2 text-sm">
                  <input
                    name="consenso"
                    type="checkbox"
                    required
                    class="mt-1 rounded border-border dark:border-darkmode-border"
                  />
                  <span>
                    Ho letto l'<a href="/terms">informativa privacy</a> e acconsento al
                    trattamento dei dati per essere ricontattato.
                  </span>
                </label>
                <p class={errorClass} data-error-for="consenso" hidden></p>
              </div>

              {/* Honeypot: fuori dallo schermo e fuori dal flusso di tabulazione. */}
              <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
                <label for="sito">Sito web</label>
                <input id="sito" name="sito" type="text" tabindex="-1" autocomplete="off" />
              </div>

              {/* Millisecondi di compilazione, valorizzati dal client al submit. */}
              <input name="elapsed" type="hidden" value="0" />

              {
                turnstileSiteKey && (
                  <div
                    id="turnstile-widget"
                    class="mb-6"
                    data-sitekey={turnstileSiteKey}
                  />
                )
              }

              <button type="submit" class="glass-t rounded-md px-6 py-2 font-bold">
                Invia
              </button>

              <p id="contact-status" class="mt-4 text-sm" role="status" aria-live="polite" hidden>
              </p>

              <noscript>
                <p class="mt-4 text-sm">
                  L'invio del modulo richiede JavaScript per la verifica antispam.
                  In alternativa scrivimi direttamente via email.
                </p>
              </noscript>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  async
  defer
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const status = form.querySelector<HTMLElement>("#contact-status");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const elapsed = form.querySelector<HTMLInputElement>("input[name=elapsed]");
    const widgetHolder = form.querySelector<HTMLElement>("#turnstile-widget");
    const loadedAt = Date.now();
    let widgetId: string | undefined;

    const renderWidget = () => {
      if (!widgetHolder || !window.turnstile) return;
      if (widgetHolder.dataset.rendered === "true") return;
      const sitekey = widgetHolder.dataset.sitekey;
      if (!sitekey) return;
      widgetHolder.dataset.rendered = "true";
      widgetId = window.turnstile.render(widgetHolder, { sitekey });
    };

    if (window.turnstile) {
      renderWidget();
    } else {
      // api.js è caricato in async: attendiamo che si registri senza bloccare la pagina.
      const poll = window.setInterval(() => {
        if (!window.turnstile) return;
        window.clearInterval(poll);
        renderWidget();
      }, 150);
      window.setTimeout(() => window.clearInterval(poll), 10_000);
    }

    const showStatus = (message: string, ok: boolean) => {
      if (!status) return;
      status.textContent = message;
      status.hidden = false;
      status.className = `mt-4 text-sm ${
        ok ? "text-green-700 dark:text-green-400" : "text-red-600 dark:text-red-400"
      }`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
        el.textContent = "";
        el.hidden = true;
      });
      if (elapsed) elapsed.value = String(Date.now() - loadedAt);
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Invio…";
      }

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { accept: "application/json" },
        });
        const payload = (await response.json().catch(() => ({}))) as {
          ok?: boolean;
          error?: string;
          fields?: Record<string, string[] | undefined>;
        };

        if (response.ok && payload.ok) {
          form.reset();
          showStatus("Messaggio inviato. Ti risponderò appena possibile.", true);
        } else {
          for (const [field, messages] of Object.entries(payload.fields ?? {})) {
            const target = form.querySelector<HTMLElement>(
              `[data-error-for="${field}"]`,
            );
            const message = messages?.[0];
            if (!target || !message) continue;
            target.textContent = message;
            target.hidden = false;
          }
          showStatus(payload.error ?? "Invio non riuscito. Riprova più tardi.", false);
        }
      } catch {
        showStatus("Connessione non disponibile. Riprova più tardi.", false);
      } finally {
        window.turnstile?.reset(widgetId);
        if (submit) {
          submit.disabled = false;
          submit.textContent = "Invia";
        }
      }
    });
  }

  // ClientRouter è attivo: astro:page-load scatta sia al primo caricamento
  // sia dopo ogni navigazione client-side.
  document.addEventListener("astro:page-load", initContactForm);
</script>
