# Copia questo file in `.env` (gitignorato) per lo sviluppo locale.
#
# In PRODUZIONE questi valori NON vanno in un file: si impostano come variabili
# d'ambiente del progetto Cloudflare Pages
# (Settings -> Environment variables), spuntando "Encrypt" su quelle segrete.
# L'endpoint le legge da locals.runtime.env, non da qui.

# --- Resend (https://resend.com) ---
# Chiave API. Segreta.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Dove arrivano i messaggi del form.
CONTACT_TO_EMAIL=tu@esempio.it

# Mittente. Il dominio deve essere verificato su Resend con SPF e DKIM,
# altrimenti le email finiscono in spam o vengono rifiutate.
CONTACT_FROM_EMAIL=Sito Marco Ponti <no-reply@esempio.it>

# --- Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) ---
# Site key: pubblica, viene inlineata nell'HTML a build time.
# Su Cloudflare Pages va impostata come variabile NON criptata, perché
# serve durante la build.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key: segreta, usata solo server-side per validare il token.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Nota: le due chiavi Turnstile qui sopra sono le chiavi di test documentate da
# Cloudflare ("always passes"), utili in locale. In produzione sostituiscile con
# quelle del tuo widget.
